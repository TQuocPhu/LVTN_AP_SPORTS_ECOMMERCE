{
  "name": "lvtn-ap-sports-ecommerce",
  "version": "1.0.0",
  "private": true,
  "description": "AP Sports Ecommerce Full-Stack System",
  "scripts": {
    "backend": "cd backend && gradlew.bat bootRun",
    "frontend": "cd frontend && npm run dev",
    "mobile": "cd mobile-app && npx expo start --tunnel --port 8081",
    "mobile:tunnel": "cd mobile-app && npx expo start --tunnel --port 8081",
    "mobile:lan": "cd mobile-app && npx expo start --lan --port 8081",
    "mobile:android": "cd mobile-app && npx expo start --android --port 8081",
    "mobile:ios": "cd mobile-app && npx expo start --ios --port 8081",
    "build:backend": "cd backend && gradlew.bat build",
    "build:frontend": "cd frontend && npm run build"
  }
}
