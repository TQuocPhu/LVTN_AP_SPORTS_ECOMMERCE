# Server Configuration
SERVER_PORT=8080

# Database Configuration (PostgreSQL Production)
DB_URL=jdbc:postgresql://localhost:5432/ap_sports_ecommerce
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=postgres
DB_PASSWORD=123456
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ap_redis_123456

# JWT Authentication Secrets
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000

# Spring Mail (SMTP Credentials for Email Activation & Contact Responses)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Cloud Storage (Cloudinary / MinIO Image Uploads)
STORAGE_TYPE=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# VNPay Payment Gateway Credentials
VNP_TMN_CODE=your_tmn_code
VNP_HASH_SECRET=your_hash_secret
VNP_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/checkout/vnpay-return

# Shipping API Integration (GHN & GHTK)
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api/v2
GHN_TOKEN=your_ghn_token
GHN_SHOP_ID=123456

# CORS Whitelist
CORS_ALLOWED_ORIGINS=http://localhost:3000
